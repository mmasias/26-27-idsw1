@startuml

participant Persona
participant Movimiento
participant Publico
participant Aura

Persona -> Movimiento : se marca

Publico -> Movimiento : ve
Publico -> Movimiento : interpreta

alt Buena impresion
    Publico -> Aura : mejora su estado
else Sin impresion relevante
    Publico -> Aura : mantiene su estado
else Mala impresion
    Publico -> Aura : empeora su estado
end

Aura -> Persona : representa la percepcion sobre

@enduml